---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title?: string;
  description?: string;
  math?: boolean;
  pageStyles?: string[];
}

const { title, description, math, pageStyles = [] } = Astro.props;
---

<BaseLayout title={title} description={description} math={math} pageStyles={pageStyles}>
  <header class="top">
    <a class="wordmark" href="/">闲话</a>

    <nav class="top-nav" aria-label="站点导航">
      <a href="/archive/">归档</a>
      <div class="nav-drop">
        <a href="/readlist/" class="nav-drop-trigger">清单</a>
        <div class="nav-drop-menu">
          <div class="nav-drop-panel">
            <a href="/readlist/">阅读清单</a>
            <a href="/light/">电影清单</a>
            <a href="/want/">心愿单</a>
            <a href="/places/">足迹地图</a>
          </div>
        </div>
      </div>
      <a href="/tags/">标签</a>
      <a href="/categories/">分类</a>
      <a href="/stats/">统计</a>
      <a href="/random/">随便看看</a>
      <a href="/about/">关于</a>
    </nav>

    <div class="top-actions">
      <button id="search-trigger" class="search-trigger" type="button" data-cmdk-trigger aria-label="站内搜索" title="站内搜索 (Ctrl+K 或 /)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="search-trigger-label">搜索</span>
        <kbd class="search-trigger-kbd">⌘K</kbd>
      </button>
      <a href="/feed.xml" class="top-rss" title="RSS 订阅">RSS</a>
      <button id="theme-toggle-nav" class="theme-toggle-nav" aria-label="切换深色/浅色主题">
        <span class="theme-icon-nav"></span>
      </button>
      <button class="nav-hamburger" id="nav-hamburger" aria-label="菜单" aria-expanded="false" aria-controls="nav-overlay" type="button">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <main class="page-content" id="main-content" aria-label="内容">
    <div class="wrapper">
      <slot />
    </div>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <span class="footer-copy">&copy; 2026 Lcc</span>
      <span class="footer-powered">把日常写成值得回看的片段 · Astro</span>
    </div>
  </footer>

  <div class="nav-overlay" id="nav-overlay" aria-hidden="true">
    <ul class="nav-overlay-links">
      <li class="overlay-search-wrap">
        <button type="button" class="nav-overlay-search" data-cmdk-trigger>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span>搜索文章…</span>
        </button>
      </li>
      <li><a href="/">首页</a></li>
      <li><a href="/archive/">归档</a></li>
      <li><a href="/tags/">标签</a></li>
      <li><a href="/categories/">分类</a></li>
      <li class="overlay-section">清单</li>
      <li class="overlay-sub"><a href="/light/">电影清单</a></li>
      <li class="overlay-sub"><a href="/readlist/">阅读清单</a></li>
      <li class="overlay-sub"><a href="/want/">心愿单</a></li>
      <li class="overlay-sub"><a href="/places/">足迹地图</a></li>
      <li class="overlay-section">其他</li>
      <li><a href="/stats/">统计</a></li>
      <li><a href="/about/">关于</a></li>
      <li><a href="/random/">随便看看</a></li>
      <li><a href="/feed.xml">RSS</a></li>
    </ul>
  </div>

  <script>
    // 当前页高亮
    document.querySelectorAll<HTMLAnchorElement>('.top-nav a, .nav-overlay-links a').forEach((link) => {
      if (link.pathname === window.location.pathname) link.setAttribute('aria-current', 'page');
    });

    // 移动端抽屉
    document.addEventListener('DOMContentLoaded', () => {
      const hamburger = document.getElementById('nav-hamburger');
      const overlay = document.getElementById('nav-overlay');
      const setMenuOpen = (open: boolean) => {
        if (!hamburger || !overlay) return;
        overlay.classList.toggle('active', open);
        hamburger.classList.toggle('active', open);
        hamburger.setAttribute('aria-expanded', String(open));
        overlay.setAttribute('aria-hidden', String(!open));
        document.body.style.overflow = open ? 'hidden' : '';
      };

      if (hamburger && overlay) {
        hamburger.addEventListener('click', () => {
          setMenuOpen(!overlay.classList.contains('active'));
        });
        overlay.querySelectorAll('a, [data-cmdk-trigger]').forEach((el) => {
          el.addEventListener('click', () => setMenuOpen(false));
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && overlay.classList.contains('active')) setMenuOpen(false);
        });
      }

      // 触屏设备上的“清单”下拉兼容：首次点击展开，再次点击跳转
      const drop = document.querySelector('.nav-drop');
      const dropTrigger = document.querySelector<HTMLAnchorElement>('.nav-drop-trigger');
      if (drop && dropTrigger) {
        dropTrigger.addEventListener('click', (e) => {
          const isTouchLike = window.matchMedia('(hover: none), (pointer: coarse)').matches;
          if (isTouchLike && !drop.classList.contains('open')) {
            e.preventDefault();
            drop.classList.add('open');
          }
        });
        document.addEventListener('click', (e) => {
          if (drop.classList.contains('open') && e.target instanceof Node && !drop.contains(e.target)) {
            drop.classList.remove('open');
          }
        });
      }
    });

    // 返回顶部
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('back-to-top');
      const ring = document.getElementById('ring-fill');
      if (!btn) return;
      const circumference = 119.38;
      window.addEventListener(
        'scroll',
        () => {
          const scrollTop = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const progress = docHeight > 0 ? scrollTop / docHeight : 0;
          btn.classList.toggle('visible', scrollTop > 300);
          if (ring) ring.style.strokeDashoffset = String(circumference * (1 - progress));
        },
        { passive: true }
      );
      btn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });
  </script>

  <button class="back-to-top" id="back-to-top" title="返回顶部" aria-label="返回顶部">
    <svg class="back-to-top-ring" width="44" height="44" viewBox="0 0 44 44" aria-hidden="true">
      <circle class="ring-bg" cx="22" cy="22" r="19" fill="none" stroke="currentColor" stroke-width="2" opacity="0.15"/>
      <circle class="ring-fill" id="ring-fill" cx="22" cy="22" r="19" fill="none" stroke="currentColor" stroke-width="2.5" stroke-dasharray="119.38" stroke-dashoffset="119.38" stroke-linecap="round" transform="rotate(-90 22 22)"/>
    </svg>
    <svg class="back-to-top-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
  </button>
</BaseLayout>
