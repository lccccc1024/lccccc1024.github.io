---
import PageLayout from '../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import books from '../data/books';
import places from '../data/places';

const allPosts = await getCollection('posts');
const sorted = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const tiles = sorted.slice(0, 2);
const latest = sorted.slice(0, 3);
const postCount = sorted.length;

const years = sorted.map((p) => p.data.date.getFullYear());
const firstYear = years.length ? Math.min(...years) : new Date().getFullYear();
const lastYear = years.length ? Math.max(...years) : new Date().getFullYear();
const spanYears = years.length ? (lastYear - firstYear).toFixed(1) : '0';

const lastDate = sorted[0] ? sorted[0].data.date.toISOString().slice(0, 10) : '—';

const tagFreq = new Map<string, number>();
for (const post of sorted) {
  for (const tag of post.data.tags ?? []) {
    tagFreq.set(tag, (tagFreq.get(tag) ?? 0) + 1);
  }
}
const topTags = [...tagFreq.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 7)
  .map(([tag]) => tag);

function fmt(d: Date) {
  return d.toISOString().slice(0, 10);
}

function shortDate(d: Date) {
  const iso = d.toISOString().slice(0, 10);
  return `${iso.slice(5, 7)}.${iso.slice(8, 10)}`;
}

function readingTime(body = '') {
  return Math.max(1, Math.ceil(body.length / 200));
}

function firstImg(body = '') {
  const m = body.match(/!\[.*?\]\((.*?)\)/);
  return m ? m[1] : null;
}

function coverVariant(id: string) {
  return [...id].reduce((sum, char) => sum + char.codePointAt(0)!, 0) % 4;
}

function coverLabel(title: string) {
  return title.replace(/[\s\d._+\-—（）()]/g, '').slice(0, 8) || '随笔';
}
---

<PageLayout title="首页" pageStyles={['/css/home.css']}>
  <div class="bento">
    <section class="tile hero-tile" aria-labelledby="hero-title">
      <div>
        <span class="eyebrow">Vol. {postCount} · {firstYear} → {lastYear}</span>
        <h1 class="hero-title" id="hero-title">闲话之间，<br />留住日常。</h1>
        <p class="hero-description">一些生活的切片，一些折腾的笔记。把值得记住的事，慢慢写下来。</p>
      </div>
      <div class="hero-actions">
        <a class="hero-button" href="/archive/">翻开文章 <span aria-hidden="true">↗</span></a>
        <span class="hero-meta">LAST · {lastDate}</span>
      </div>
    </section>

    {tiles.map((post, index) => {
      const img = firstImg(post.body);
      const category = post.data.categories?.[0] || '闲话';
      return (
        <a class={`tile post-tile p${index + 1}`} href={`/posts/${post.id}/`}>
          {img ? (
            <img src={img} alt="" class="post-tile-img" loading="lazy" />
          ) : (
            <div class="generated-cover" data-cover={coverVariant(post.id)} aria-hidden="true">
              <span class="cover-index">NO. {String(index + 1).padStart(2, '0')}</span>
              <span class="cover-category">{category}</span>
              <strong class="cover-title">{coverLabel(post.data.title)}</strong>
              <span class="cover-rule"></span>
              <span class="cover-signature">ASA · JOURNAL</span>
            </div>
          )}
          <div>
            <h3>{post.data.title}</h3>
            <div class="tile-meta">
              {fmt(post.data.date)} · {category} · {readingTime(post.body)} MIN
            </div>
          </div>
        </a>
      );
    })}

    <div class="tile stat-tile">
      <span class="tile-k">Archive</span>
      <div>
        <strong class="stat-value">{postCount}</strong>
        <div class="stat-foot">
          <span>篇文章</span>
          <span>{spanYears} 年</span>
        </div>
      </div>
    </div>

    <div class="tile list-tile">
      <span class="tile-k">最新发布</span>
      <div class="tile-rows">
        {latest.map((post) => (
          <a class="tile-row" href={`/posts/${post.id}/`}>
            <em>{shortDate(post.data.date)}</em>
            <span>{post.data.title}</span>
          </a>
        ))}
      </div>
      <a class="tile-more" href="/archive/">查看全部 {postCount} 篇 →</a>
    </div>

    <div class="tile books-tile">
      <span class="tile-k">在读</span>
      <div class="spines" aria-hidden="true">
        {books.slice(0, 3).map(() => <span class="spine"></span>)}
      </div>
      <p class="tile-note">《{books[0]?.title ?? '书单'}》等 {books.length} 本</p>
    </div>

    <div class="tile tag-tile">
      <span class="tile-k">标签</span>
      <div class="tile-chips">
        {topTags.map((tag) => <a class="tile-chip" href={`/tags/#${tag}`}>{tag}</a>)}
        <a class="tile-chip" href="/tags/">全部 →</a>
      </div>
    </div>

    <a class="tile map-tile" href="/places/">
      <span class="tile-k">足迹</span>
      <div class="map-label">
        <b>{places.length}</b>
        <span>座城市 · 查看地图 →</span>
      </div>
    </a>
  </div>
</PageLayout>
