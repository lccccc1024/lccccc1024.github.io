---
import PageLayout from '../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const sorted = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const recent = sorted.slice(0, 8);
const postCount = sorted.length;

const years = sorted.map((p) => p.data.date.getFullYear());
const firstYear = years.length ? Math.min(...years) : new Date().getFullYear();
const lastYear = years.length ? Math.max(...years) : firstYear;

const byYear: Array<{ year: number; posts: typeof recent }> = [];
for (const post of recent) {
  const year = post.data.date.getFullYear();
  const last = byYear[byYear.length - 1];
  if (last && last.year === year) last.posts.push(post);
  else byYear.push({ year, posts: [post] });
}

function fmtDate(d: Date) {
  return d.toISOString().slice(0, 10).replace(/-/g, '.');
}

function excerptOf(post: (typeof recent)[number]) {
  if (post.data.description) return post.data.description;
  return post.body
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/[#*`>\-]/g, '')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 72);
}
---

<PageLayout title="首页" pageStyles={['/css/home.css']}>
  <section class="intro">
    <p class="kicker">ASA'S JOURNAL · {firstYear} — {lastYear}</p>
    <h1 class="hero-title">闲话之间，<br />留住日常。</h1>
    <p class="lede">一些生活的切片，一些折腾的笔记。把值得记住的事，慢慢写下来。</p>
    <p class="links">
      <a href="/archive/">翻开归档 →</a>
      <a href="/about/">关于这个小站</a>
    </p>
  </section>

  <section class="feed">
    <div class="feed-head">
      <h2>最近写下的</h2>
      <span>{postCount} POSTS</span>
    </div>

    {byYear.map((group) => (
      <>
        <div class="feed-year">{group.year}</div>
        {group.posts.map((post) => (
          <a class="feed-row" href={`/posts/${post.id}/`}>
            <time datetime={post.data.date.toISOString().slice(0, 10)}>{fmtDate(post.data.date)}</time>
            <div>
              <h3>{post.data.title}</h3>
              <p>{excerptOf(post)}</p>
            </div>
            <span class="cat">{post.data.categories?.[0] ?? '闲话'}</span>
          </a>
        ))}
      </>
    ))}
  </section>

  <div class="more">
    <a href="/archive/">查看全部 {postCount} 篇</a>
  </div>
</PageLayout>
