---
import PageLayout from '../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const posts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const catMap: Record<string, typeof posts> = Object.create(null);
posts.forEach(post => {
  (post.data.categories || []).forEach(cat => {
    if (!catMap[cat]) catMap[cat] = [];
    catMap[cat].push(post);
  });
});
const cats = Object.keys(catMap).sort();
const fmt = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '.');
---

<PageLayout title="分类">
  <div class="page-head">
    <h1 class="page-title">分类</h1>
    <p class="page-sub">{cats.length} 个分类，共 {posts.length} 篇。</p>
  </div>

  {cats.length > 0 && (
    <div class="tag-cloud">
      {cats.map(cat => (
        <a href={`#${cat}`}>
          {cat}
          <span class="tag-count">{catMap[cat].length}</span>
        </a>
      ))}
    </div>
  )}

  {cats.map(cat => (
    <div>
      <h2 id={cat} class="archive-year">{cat}（{catMap[cat].length} 篇）</h2>
      <ul class="archive-list">
        {catMap[cat].map(post => (
          <li class="archive-item">
            <span class="archive-date">{fmt(post.data.date)}</span>
            <a href={`/posts/${post.id}/`}>{post.data.title}</a>
            <span class="archive-category">{post.data.tags?.[0]}</span>
          </li>
        ))}
      </ul>
    </div>
  ))}

  <a href="/" class="page-end">← 返回首页</a>
</PageLayout>
