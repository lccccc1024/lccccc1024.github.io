---
import PageLayout from '../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const posts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const yearMap: Record<string, typeof posts> = Object.create(null);
posts.forEach(post => {
  const year = post.data.date.getFullYear().toString();
  if (!yearMap[year]) yearMap[year] = [];
  yearMap[year].push(post);
});
const years = Object.keys(yearMap).sort((a, b) => Number(b) - Number(a));

function excerptOf(post: (typeof posts)[number]) {
  if (post.data.description) return post.data.description;
  const body = post.body ?? '';
  return body
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/[#*`>\-]/g, '')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 64);
}
---

<PageLayout title="文章归档">
  <div class="page-head">
    <h1 class="page-title">文章归档</h1>
    <p class="page-sub">共 {posts.length} 篇，从 {years[years.length - 1]} 年写到现在。</p>
  </div>

  <div>
    {years.map(year => (
      <div>
        <h3 class="archive-year">{year} 年（{yearMap[year].length} 篇）</h3>
        <ul class="archive-list">
          {yearMap[year].map(post => (
            <li class="archive-item">
              <span class="archive-date">{post.data.date.toISOString().slice(5, 10).replace('-', '.')}</span>
              <a href={`/posts/${post.id}/`}>{post.data.title}</a>
              {post.data.categories?.length > 0 && (
                <span class="archive-category">{post.data.categories[0]}</span>
              )}
              <p class="archive-excerpt">{excerptOf(post)}</p>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <a href="/" class="page-end">← 返回首页</a>
  </div>
</PageLayout>
