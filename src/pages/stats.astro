---
import PageLayout from '../layouts/PageLayout.astro';
import { getPublishedPosts, readingMinutesOf, wordCountOf } from '../utils/posts';

const descPosts = await getPublishedPosts();
const posts = [...descPosts].reverse();

// Total stats
const totalPosts = posts.length;
const totalWords = posts.reduce((sum, p) => sum + wordCountOf(p.body), 0);
const totalMinutes = posts.reduce((sum, p) => sum + readingMinutesOf(p.body), 0);
const oldest = posts[0]?.data.date || new Date();
const newest = posts[posts.length - 1]?.data.date || new Date();
const spanDays = Math.ceil((newest.getTime() - oldest.getTime()) / (1000 * 60 * 60 * 24));

// Heatmap data (last 365 days)
const heatmap: Record<string, number> = {};
const today = new Date();
for (let i = 364; i >= 0; i--) {
  const d = new Date(today);
  d.setDate(d.getDate() - i);
  const key = d.toISOString().slice(0, 10);
  heatmap[key] = 0;
}
const paddingDays = new Date(Object.keys(heatmap)[0]).getUTCDay();
posts.forEach(p => {
  const key = p.data.date.toISOString().slice(0, 10);
  if (heatmap[key] !== undefined) heatmap[key] = (heatmap[key] || 0) + 1;
});

// Posts by year/month
const byYear: Record<string, { count: number; words: number }> = {};
posts.forEach(p => {
  const y = p.data.date.getFullYear();
  if (!byYear[y]) byYear[y] = { count: 0, words: 0 };
  byYear[y].count++;
  byYear[y].words += wordCountOf(p.body);
});

// Categories
const cats: Record<string, number> = Object.create(null);
posts.forEach(p => (p.data.categories || []).forEach(c => { cats[c] = (cats[c] || 0) + 1; }));
const sortedCats = Object.entries(cats).sort((a, b) => b[1] - a[1]);

// Tags
const tags: Record<string, number> = Object.create(null);
posts.forEach(p => (p.data.tags || []).forEach(t => { tags[t] = (tags[t] || 0) + 1; }));
const sortedTags = Object.entries(tags).sort((a, b) => b[1] - a[1]);

// Longest posts
const longest = [...posts].sort((a, b) => wordCountOf(b.body) - wordCountOf(a.body)).slice(0, 5);

---

<PageLayout title="写作统计">
  <div class="page-head">
    <h1 class="page-title">写作统计</h1>
    <p class="page-sub">这些年写下的字数、节奏与分布。</p>
  </div>

  <div>

    <!-- Overview cards -->
    <div class="stats-grid">
      <div class="stat-card"><span class="stat-value">{totalPosts}</span><span class="stat-label">文章</span></div>
      <div class="stat-card"><span class="stat-value">{(totalWords / 1000).toFixed(1)}k</span><span class="stat-label">字数</span></div>
      <div class="stat-card"><span class="stat-value">{totalMinutes}</span><span class="stat-label">分钟阅读量</span></div>
      <div class="stat-card"><span class="stat-value">{spanDays}</span><span class="stat-label">天跨度</span></div>
    </div>

    <!-- Heatmap -->
    <h3 style="margin-top: var(--space-xl);">写作热力图</h3>
    <div class="heatmap" id="heatmap-wrap">
      <div class="heatmap-labels">
        {['日', '一', '二', '三', '四', '五', '六'].map(d => <span class="heatmap-day-label">{d}</span>)}
      </div>
      <div class="heatmap-grid">
        {Array.from({ length: paddingDays }, () => <div class="heatmap-cell" style="visibility:hidden"></div>)}
        {Object.entries(heatmap).map(([date, count]) => {
          const level = count === 0 ? 0 : count === 1 ? 1 : count === 2 ? 2 : 3;
          return (
            <div
              class={'heatmap-cell level-' + level}
              title={date + ': ' + count + ' 篇'}
              data-date={date}
              data-count={count}
              tabindex="0"
              role="button"
              aria-label={date + '：' + count + ' 篇'}
            ></div>
          );
        })}
      </div>
    </div>
    <div class="heatmap-meta">
      <span class="heatmap-detail" id="heatmap-detail">点击或悬停方块查看当日记录</span>
      <div class="heatmap-legend" aria-hidden="true">
        <span>少</span>
        <span class="heatmap-legend-cell level-0"></span>
        <span class="heatmap-legend-cell level-1"></span>
        <span class="heatmap-legend-cell level-2"></span>
        <span class="heatmap-legend-cell level-3"></span>
        <span>多</span>
      </div>
    </div>

    <!-- Yearly stats -->
    <h3 style="margin-top: var(--space-xl);">按年统计</h3>
    <div class="bar-chart">
      {Object.entries(byYear).sort((a, b) => Number(b[0]) - Number(a[0])).map(([year, data]) => {
        const maxCount = Math.max(...Object.values(byYear).map(d => d.count), 1);
        const pct = (data.count / maxCount) * 100;
        return (
          <div class="bar-row">
            <span class="bar-label">{year}</span>
            <div class="bar-track">
              <div class="bar-fill" style={'width: ' + pct + '%'}></div>
            </div>
            <span class="bar-value">{data.count} 篇 · {(data.words / 1000).toFixed(1)}k 字</span>
          </div>
        );
      })}
    </div>

    <!-- Category distribution -->
    <h3 style="margin-top: var(--space-xl);">分类分布</h3>
    <div class="tag-cloud">
      {sortedCats.map(([cat, count]) => {
        const size = 0.85 + (count / Math.max(...sortedCats.map(c => c[1]))) * 0.4;
        return <a href={'/categories/#' + cat} style={'font-size: ' + size + 'rem;'}>{cat}<span class="tag-count">{count}</span></a>;
      })}
    </div>

    <!-- Tag cloud -->
    <h3 style="margin-top: var(--space-xl);">标签分布</h3>
    <div class="tag-cloud">
      {sortedTags.map(([tag, count]) => {
        const size = 0.85 + (count / Math.max(...sortedTags.map(t => t[1]))) * 0.4;
        return <a href={'/tags/#' + tag} style={'font-size: ' + size + 'rem;'}>{tag}<span class="tag-count">{count}</span></a>;
      })}
    </div>

    <!-- Longest posts -->
    <h3 style="margin-top: var(--space-xl);">最长的文章</h3>
    <ol class="top-list">
      {longest.map(p => (
        <li>
          <a href={'/posts/' + p.id + '/'}>{p.data.title}</a>
          <span class="top-list-meta">{wordCountOf(p.body)} 字 · {readingMinutesOf(p.body)} 分钟</span>
        </li>
      ))}
    </ol>

    <a href="/" class="page-end">← 返回首页</a>
  </div>
</PageLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const detail = document.getElementById('heatmap-detail');
    const grid = document.querySelector('.heatmap-grid');
    if (!detail || !grid) return;

    const show = (cell: Element | null) => {
      if (!(cell instanceof HTMLElement) || !cell.dataset.date) return;
      detail.textContent = `${cell.dataset.date}：${cell.dataset.count || 0} 篇`;
    };

    grid.addEventListener('click', (e) => {
      const target = e.target instanceof Element ? e.target.closest('.heatmap-cell[data-date]') : null;
      show(target);
    });
    grid.addEventListener('mouseover', (e) => {
      const target = e.target instanceof Element ? e.target.closest('.heatmap-cell[data-date]') : null;
      show(target);
    });
    grid.addEventListener('focusin', (e) => {
      const target = e.target instanceof Element ? e.target.closest('.heatmap-cell[data-date]') : null;
      show(target);
    });
  });
</script>

<style>
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-md); margin: var(--space-lg) 0; }
  .stat-card { text-align: center; padding: var(--space-lg); background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-md); }
  .stat-value { display: block; font-size: 2.3rem; font-weight: 600; color: var(--accent); line-height: 1.15; }
  .stat-label { font-size: 0.92rem; color: var(--text-tertiary); }
  .heatmap { overflow-x: auto; display: flex; gap: 6px; margin: var(--space-md) 0 var(--space-sm); }
  .heatmap-labels { display: flex; flex-direction: column; gap: 3px; padding-top: 0; }
  .heatmap-day-label { font-size: 0.75rem; color: var(--text-tertiary); height: 12px; line-height: 12px; }
  .heatmap-grid { display: grid; grid-template-rows: repeat(7, 12px); grid-auto-flow: column; grid-auto-columns: 12px; gap: 3px; }
  .heatmap-cell { width: 12px; height: 12px; border-radius: 2px; background: var(--bg-code); cursor: pointer; }
  .heatmap-cell.level-1, .heatmap-legend-cell.level-1 { background: var(--accent-light); }
  .heatmap-cell.level-2, .heatmap-legend-cell.level-2 { background: var(--accent); opacity: 0.6; }
  .heatmap-cell.level-3, .heatmap-legend-cell.level-3 { background: var(--accent); }
  .heatmap-meta { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 0.88rem; color: var(--text-tertiary); margin-bottom: var(--space-md); }
  .heatmap-legend { display: flex; align-items: center; gap: 4px; font-size: 0.82rem; }
  .heatmap-legend-cell { width: 11px; height: 11px; border-radius: 2px; background: var(--bg-code); display: inline-block; }
  .bar-chart { display: flex; flex-direction: column; gap: var(--space-sm); margin: var(--space-md) 0; }
  .bar-row { display: flex; align-items: center; gap: var(--space-md); }
  .bar-label { width: 54px; font-weight: 600; font-size: 0.95rem; color: var(--text-secondary); flex-shrink: 0; }
  .bar-track { flex: 1; height: 24px; background: var(--bg-code); border-radius: var(--radius-sm); overflow: hidden; }
  .bar-fill { height: 100%; background: var(--accent); border-radius: var(--radius-sm); transition: width var(--dur-3) var(--ease); }
  .bar-value { width: 148px; font-size: 0.88rem; color: var(--text-tertiary); flex-shrink: 0; text-align: right; }
  .top-list { list-style: decimal; padding-left: 1.5em; }
  .top-list li { margin: var(--space-sm) 0; }
  .top-list-meta { font-size: 0.88rem; color: var(--text-tertiary); margin-left: var(--space-sm); }
  @media (max-width: 640px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .bar-row { flex-wrap: wrap; gap: 6px 10px; }
    .bar-track { min-width: 140px; }
    .bar-value { width: auto; font-size: 0.85rem; text-align: left; }
    .heatmap-meta { flex-wrap: wrap; }
  }
</style>
