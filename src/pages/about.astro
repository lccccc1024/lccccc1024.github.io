---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="关于我">
  <div class="page-head">
    <h1 class="page-title">关于</h1>
    <p class="page-sub">记录生活，也记录折腾过的那些事。</p>
  </div>

  <h2 class="section-title">自我介绍</h2>
  <div class="about-card">
    <p>一个喜欢记录生活的牛马。</p>
    <p>这里是用来记录日常生活和技术笔记的地方。</p>
  </div>

  <h2 class="section-title">个人标签</h2>
    <div class="about-card">
      <ul>
        <li>摄影师新手 📷</li>
        <li>骑行爱好者 🚴</li>
        <li>电影爱好者 🎬</li>
        <li>NAS 玩家 🖥️</li>
      </ul>
    </div>

    <h2 class="section-title">技能树</h2>
    <div class="about-card">
      <ul>
        <li>日常记录：生活、杂记、周记</li>
        <li>技术折腾：NAS、服务器、图床</li>
        <li>兴趣爱好：摄影、骑行、观影</li>
      </ul>
    </div>

    <h2 class="section-title">联系方式</h2>
    <div class="about-card">
      <div class="social-buttons">
        <a href="https://github.com/lccccc1024" class="social-btn social-btn--github" target="_blank" rel="noopener" aria-label="GitHub">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          <span>GitHub</span>
        </a>
        <a href="/feed.xml" class="social-btn social-btn--blog" aria-label="RSS 订阅">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20 5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/></svg>
          <span>RSS 订阅</span>
        </a>
        <a href="mailto:asa.lu@outlook.com" class="social-btn social-btn--email" target="_blank" rel="noopener" aria-label="邮箱">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          <span>邮箱</span>
        </a>
      </div>
    </div>

    <h2 class="section-title">其他页面</h2>
    <div class="about-card">
      <ul class="about-links">
        <li><a href="/readlist/">阅读清单</a> - 读过的书</li>
        <li><a href="/light/">电影清单</a> - 看过的电影</li>
        <li><a href="/want/">心愿单</a> - 想要的东西</li>
        <li><a href="/places/">足迹地图</a> - 去过的地方</li>
        <li><a href="/archive/">文章归档</a> - 所有文章</li>
        <li><a href="/categories/">文章分类</a> - 按分类浏览</li>
        <li><a href="/tags/">文章标签</a> - 按标签浏览</li>
      </ul>
    </div>

    <hr class="page-rule" />
    <a href="/" class="page-end">← 返回首页</a>
</PageLayout>
