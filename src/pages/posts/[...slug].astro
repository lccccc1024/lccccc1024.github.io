---
import PageLayout from '../../layouts/PageLayout.astro';
import { render } from 'astro:content';
import pickSignature from '../../data/signature.ts';
import {
  excerptOf,
  getPublishedPosts,
  readingMinutesOf,
  seriesBase,
  wordCountOf,
} from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Find prev/next
const sorted = await getPublishedPosts();
const currentIdx = sorted.findIndex(p => p.id === post.id);
const prev = currentIdx < sorted.length - 1 ? sorted[currentIdx + 1] : null;
const next = currentIdx > 0 ? sorted[currentIdx - 1] : null;

// Related posts (by tags)
const related = sorted
  .filter(p => p.id !== post.id && p.data.tags?.some(t => post.data.tags?.includes(t)))
  .slice(0, 3);

// Series detection: only show when at least 2 posts share the same series
const base = seriesBase(post);
const seriesPosts = base.length > 1 ? sorted.filter(p => seriesBase(p) === base).reverse() : [];

const fmt = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '.');
const wordCount = wordCountOf(post.body);
const readMinutes = readingMinutesOf(post.body);
const postExcerpt = excerptOf(post, 140);

// JSON-LD structured data
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  description: postExcerpt,
  author: {
    '@type': 'Person',
    name: 'Lcc',
  },
  keywords: (post.data.tags || []).join(', '),
};

// Post age check (static fallback, refined client-side by date)
const now = new Date();
const postAge = Math.floor((now.getTime() - post.data.date.getTime()) / (365.25 * 24 * 60 * 60 * 1000));
const postDateIso = post.data.date.toISOString().slice(0, 10);
---

<PageLayout title={post.data.title} description={postExcerpt} math={post.data.math}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  <div class="post-layout">
  <article class="post-card post-body">
    <header class="post-header">
      <h1 class="post-title">{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={postDateIso}>{fmt(post.data.date)}</time>
        <span class="meta-separator">·</span>
        <span>{wordCount} 字 · 约 {readMinutes} 分钟</span>
        {post.data.categories?.length > 0 && (
          <>
            <span class="meta-separator">·</span>
            <span class="post-categories">
              {post.data.categories.map((cat, idx) => (
                <>
                  {idx > 0 && ' / '}
                  <a href={`/categories/#${cat}`}>{cat}</a>
                </>
              ))}
            </span>
          </>
        )}
        <span class="meta-separator">·</span>
        <button class="copy-link-btn" id="copy-link-btn" title="复制链接" aria-label="复制文章链接">复制链接</button>
      </div>
    </header>

    <div
      class="post-age-notice"
      id="post-age-notice"
      data-post-date={postDateIso}
      hidden={postAge < 1}
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="12" x2="12" y2="8"/><line x1="12" y1="16" x2="12.01" y2="16"/><line x1="12" y1="12" x2="16" y2="12"/></svg>
      <span id="post-age-text">本文写于 {Math.max(1, postAge)} 年前，内容可能已过时</span>
    </div>

    <div class="post-content">
      <Content />
    </div>

    <!-- Series navigation -->
    {seriesPosts.length > 1 && (
      <div class="post-series">
        <h4 class="post-series-title">📚 系列文章</h4>
        <ul class="post-series-list">
          {seriesPosts.map(sp => (
            <li class={sp.id === post.id ? 'series-current' : ''}>
              <a href={`/posts/${sp.id}/`}>{sp.data.title}</a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Signature -->
    <div class="post-signature">
      <p>{pickSignature(post.id)}</p>
      <span class="post-signature-author">—— 闲话</span>
    </div>

    <nav class="post-nav">
      <div class="post-nav-prev">
        {prev && (
          <a href={`/posts/${prev.id}/`} rel="prev">
            <span class="nav-label">← 上一篇</span>
            <span class="nav-title">{prev.data.title}</span>
          </a>
        )}
      </div>
      <div class="post-nav-next">
        {next && (
          <a href={`/posts/${next.id}/`} rel="next">
            <span class="nav-label">下一篇 →</span>
            <span class="nav-title">{next.data.title}</span>
          </a>
        )}
      </div>
    </nav>

  </article>

  <aside class="post-rail" aria-label="文章信息">
    <div class="rail-block" id="post-toc-slot"></div>

    {post.data.tags?.length > 0 && (
      <div class="rail-block">
        <span class="rail-label">标签</span>
        <div class="rail-tags">
          {post.data.tags.map(tag => (
            <a href={`/tags/#${tag}`}>{tag}</a>
          ))}
        </div>
      </div>
    )}

    {related.length > 0 && (
      <div class="rail-block">
        <span class="rail-label">相关文章</span>
        <ul class="rail-list">
          {related.map(rp => (
            <li>
              <a href={`/posts/${rp.id}/`}>
                {rp.data.title}
                <span class="rail-date">{fmt(rp.data.date)}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </aside>

  {post.data.comments !== false && (
    <div class="post-tail">
      <section class="comments-section">
        <h2 class="section-title">评论</h2>
        <div class="giscus" id="giscus"></div>
        <script is:inline>
          (() => {
            var THEMES = {
              light: 'https://blog.950922.xyz/giscus-theme-light.css',
              dark: 'https://blog.950922.xyz/giscus-theme-dark.css',
            };
            var isDark = document.documentElement.classList.contains('dark');
            var attrs = {
              'data-repo': 'lccccc1024/lccccc1024.github.io',
              'data-repo-id': 'R_kgDOIBXa0g',
              'data-category': 'Announcements',
              'data-category-id': 'DIC_kwDOIBXa0s4C6Wys',
              'data-mapping': 'pathname',
              'data-strict': '0',
              'data-reactions-enabled': '1',
              'data-emit-metadata': '0',
              'data-input-position': 'top',
              'data-theme': isDark ? THEMES.dark : THEMES.light,
              'data-lang': 'zh-CN',
              'data-loading': 'lazy',
            };
            var s = document.createElement('script');
            s.src = 'https://giscus.app/client.js';
            s.async = true;
            s.crossOrigin = 'anonymous';
            Object.keys(attrs).forEach(function (k) {
              s.setAttribute(k, attrs[k]);
            });
            document.getElementById('giscus').appendChild(s);
          })();
        </script>
      </section>
    </div>
  )}
  </div>

  <script is:inline src="/js/toc.js" defer></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const notice = document.getElementById('post-age-notice');
      const ageText = document.getElementById('post-age-text');
      const dateStr = notice?.dataset.postDate;
      if (notice && ageText && dateStr) {
        const postTime = new Date(dateStr).getTime();
        if (Number.isFinite(postTime)) {
          const years = Math.floor((Date.now() - postTime) / (365.25 * 24 * 60 * 60 * 1000));
          if (years >= 1) {
            notice.hidden = false;
            ageText.textContent = `本文写于 ${years} 年前，内容可能已过时`;
          } else {
            notice.hidden = true;
          }
        }
      }

      const btn = document.getElementById('copy-link-btn');
      if (!btn) return;
      btn.addEventListener('click', function() {
        navigator.clipboard.writeText(window.location.href).then(function() {
          btn.textContent = '已复制';
          btn.classList.add('copied');
          setTimeout(function() {
            btn.textContent = '复制链接';
            btn.classList.remove('copied');
          }, 2000);
        }).catch(function() {
          btn.textContent = '复制失败';
          setTimeout(function() { btn.textContent = '复制链接'; }, 2000);
        });
      });
    });
  </script>
</PageLayout>
