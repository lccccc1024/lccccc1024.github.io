---
import PageLayout from '../layouts/PageLayout.astro';
import places from '../data/places';

const categoryColors: Record<string, string> = {
  '旅游': '#2b5a4b',
  '出差': '#3f5d78',
  '探亲': '#7a5a3f',
  '其他': '#6f6f68'
}

const sortedPlaces = [...places].reverse()
const placesHash = encodeURIComponent(JSON.stringify(places))
---

<PageLayout title="足迹地图" description="记录我去过的地方">
  <div class="page-head">
    <h1 class="page-title">足迹地图</h1>
    <p class="page-sub">世界那么大，我想去看看。</p>
  </div>

  <div class="list-page-content">
    <p class="stats">共记录 <strong>{places.length}</strong> 个地点</p>

    <div id="map-wrap">
      <iframe id="map-frame" src={`/map.html#${placesHash}`} loading="lazy"></iframe>
    </div>

    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>地点</th>
            <th>日期</th>
            <th>分类</th>
            <th>备注</th>
          </tr>
        </thead>
        <tbody>
          {sortedPlaces.map((place, i) => (
            <tr>
              <td data-label="序号">{i + 1}</td>
              <td data-label="地点">{place.name}</td>
              <td data-label="日期">{place.date === '0000-00-00' ? '—' : place.date}</td>
              <td data-label="分类">
                <span class="category-badge" style={`--badge-color: ${categoryColors[place.category] || '#8b5cf6'}`}>
                  {place.category}
                </span>
              </td>
              <td data-label="备注">{place.note || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <a href="/" class="page-end">← 返回首页</a>

  <style>
    #map-wrap {
      width: 100%;
      height: 500px;
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
      margin-bottom: var(--space-xl);
      overflow: hidden;
    }

    #map-frame {
      width: 100%;
      height: 100%;
      border: none;
    }

    .category-badge {
      display: inline-block;
      padding: 2px 10px;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--badge-color);
      background: color-mix(in srgb, var(--badge-color) 12%, transparent);
      border: 1px solid color-mix(in srgb, var(--badge-color) 25%, transparent);
    }

    @media (max-width: 720px) {
      #map-wrap { height: 350px; }
    }
  </style>
</PageLayout>
