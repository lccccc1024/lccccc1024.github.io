---
import PageLayout from '../layouts/PageLayout.astro';
import places from '../data/places';

const categoryColors: Record<string, string> = {
  '旅游': '#3b82f6',
  '出差': '#f59e0b',
  '探亲': '#10b981',
  '其他': '#8b5cf6'
}

const sortedPlaces = [...places].reverse()
---

<PageLayout title="足迹地图" description="记录我去过的地方">
  <div class="list-page-header">
    <h1 class="list-page-title">足迹地图</h1>
    <p class="list-page-subtitle">世界那么大，我想去看看。</p>
  </div>

  <div class="list-page-content">
    <p class="stats">共记录 <strong>{places.length}</strong> 个地点</p>

    <div id="map"></div>

    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>地点</th>
            <th>日期</th>
            <th>分类</th>
            <th>备注</th>
          </tr>
        </thead>
        <tbody>
          {sortedPlaces.map((place, i) => (
            <tr>
              <td data-label="序号">{i + 1}</td>
              <td data-label="地点">{place.name}</td>
              <td data-label="日期">{place.date}</td>
              <td data-label="分类">
                <span class="category-badge" style={`--badge-color: ${categoryColors[place.category] || '#8b5cf6'}`}>
                  {place.category}
                </span>
              </td>
              <td data-label="备注">{place.note || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <script is:inline src="https://webapi.amap.com/maps?v=1.4.15&key=be9dd191700058ef7da897f2763e4782"></script>
  <script is:inline define:vars={{ placesData: JSON.stringify(places) }}>
    window.__PLACES__ = JSON.parse(placesData);
  </script>
  <script src="/js/places.js" defer data-astro-rerun></script>

  <style>
    #map {
      width: 100%;
      height: 500px;
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
      margin-bottom: var(--space-xl);
      z-index: 0;
    }

    .category-badge {
      display: inline-block;
      padding: 2px 10px;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--badge-color);
      background: color-mix(in srgb, var(--badge-color) 12%, transparent);
      border: 1px solid color-mix(in srgb, var(--badge-color) 25%, transparent);
    }

    @media (max-width: 768px) {
      #map { height: 350px; }
    }
  </style>
</PageLayout>
